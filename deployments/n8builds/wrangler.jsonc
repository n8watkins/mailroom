{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The owner's live mailroom for the n8builds.dev apps. Deploy it with
  //   npm run deploy -- deployments/n8builds/wrangler.jsonc
  // Apps call the `Mailroom` entrypoint over a service binding (README.md).
  "name": "mailroom",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "../../src/index.ts",
  // This deployment's apps.
  "alias": { "mailroom:apps": "./apps.ts" },
  "compatibility_date": "2026-11-01",
  // No public address: only service bindings reach it.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Unrestricted recipients; the senders each app may use are checked in
  // apps.ts, and this list is the outer bound for all of them.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "prpost@n8builds.dev",
        "cutelyaskme@n8builds.dev",
        "contact@n8builds.dev",
        "nettrailers@n8builds.dev",
        "wren@n8builds.dev",
        "keysready@n8builds.dev",
        "portfoliorank@n8builds.dev",
        "support@n8builds.dev",
        // mailroom's own cap alerts to the owner (ALERT_FROM).
        "alerts@n8builds.dev"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailroom",
      "database_id": "b59df95d-1cd0-45f2-b378-c01fd1daf174",
      "migrations_dir": "../../migrations"
    }
  ],
  "queues": {
    // Email Sending events (one subscription per sending domain, README.md).
    "consumers": [
      {
        "queue": "mailroom-email-events",
        "max_batch_size": 25,
        "max_batch_timeout": 10,
        "max_retries": 8,
        "dead_letter_queue": "mailroom-email-events-dlq"
      }
    ]
  },
  // Daily cleanup of expired counters and old rows.
  "triggers": { "crons": ["23 4 * * *"] },
  "vars": {
    // The account's Email Sending limit is 1,000 a day today (GET /email/sending/limits).
    "GLOBAL_DAY_CAP": "900",
    "PRIORITY_RESERVE": "150",
    // Sends in any 32 UTC days across every app, under the 3,000 a month Workers
    // Paid includes, so Email Sending never bills (README.md, "Caps"). The apps'
    // monthly caps in apps.ts add up to at most this; npm test checks it.
    "GLOBAL_MONTH_CAP": "2500",
    // The part of GLOBAL_MONTH_CAP only priority kinds (sign-in links) may use.
    "PRIORITY_MONTH_RESERVE": "300",
    // Cap alerts (README.md, "Cap alerts"). ALERT_TO, the owner's verified Email
    // Routing destination, is a secret: npx wrangler secret put ALERT_TO -c <this file>.
    "ALERT_FROM": "alerts@n8builds.dev",
    "ADMIN_URL": "https://admin.n8builds.dev/mailroom",
    // Emails a month Workers Paid includes before $0.35 per 1,000, for the usage view.
    "MONTHLY_INCLUDED": "3000"
  },
  // Each app's hook for its bounces and complaints (the `hook` in apps.ts),
  // added as the app moves onto mailroom. Deploy the app's entrypoint first.
  "services": [
    // PR Post's paper: worker/main.js in n8watkins/pr-post.
    { "binding": "HOOK_PRPOST", "service": "pull-request-post", "entrypoint": "EmailEvents" }
  ]
}
