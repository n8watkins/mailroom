{
  "$schema": "node_modules/wrangler/config-schema.json",
  // mailroom: every app's transactional email through Cloudflare Email Service.
  // This is the template deployment. Fill in the <...> values and your senders,
  // define your apps in apps.config.ts, then `npm run deploy` (README.md, "Quick start").
  // Apps call the `Mailroom` entrypoint over a service binding.
  "name": "mailroom",
  // Wrangler deploys to the account you're logged in to. With more than one
  // account, add "account_id" here or set CLOUDFLARE_ACCOUNT_ID.
  "main": "src/index.ts",
  // Your apps: where `import ... from "mailroom:apps"` points.
  "alias": { "mailroom:apps": "./apps.config.ts" },
  "compatibility_date": "2026-11-01",
  // No public address: only service bindings reach it.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Unrestricted recipients. Every app's exact senders in apps.config.ts must be
  // listed here (`npm test` checks), and this list is the outer bound for all of them.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@example.com", "orders@example.com"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailroom",
      // From `npx wrangler d1 create mailroom`.
      "database_id": "<your D1 database id>",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    // Email Sending events (one subscription per sending domain, README.md).
    "consumers": [
      {
        "queue": "mailroom-email-events",
        "max_batch_size": 25,
        "max_batch_timeout": 10,
        "max_retries": 8,
        "dead_letter_queue": "mailroom-email-events-dlq"
      }
    ]
  },
  // Daily cleanup of expired counters and old rows.
  "triggers": { "crons": ["23 4 * * *"] },
  "vars": {
    // Sends per UTC day across all apps. Keep it under your account's Email
    // Sending daily limit (dashboard, or GET /accounts/{id}/email/sending/limits).
    "GLOBAL_DAY_CAP": "900",
    // The part of GLOBAL_DAY_CAP only `priority` kinds (sign-in links) may use.
    "PRIORITY_RESERVE": "150",
    // Sends in any 32 UTC days across all apps. Keep it under the emails your
    // plan includes (3,000 a month on Workers Paid) so Email Sending never
    // bills. Your apps' monthly caps must add up to at most this.
    "GLOBAL_MONTH_CAP": "2500",
    // The part of GLOBAL_MONTH_CAP only `priority` kinds (sign-in links) may use.
    "PRIORITY_MONTH_RESERVE": "300",
    // Emails a month your plan includes (3,000 on Workers Paid), for the usage view.
    "MONTHLY_INCLUDED": "3000"
  },
  // Each app's hook for its bounces and complaints (the `hook` in apps.config.ts).
  // Deploy the app's entrypoint first, then add its binding here, for example:
  //   { "binding": "HOOK_SHOP", "service": "my-shop", "entrypoint": "EmailEvents" }
  "services": []
}
